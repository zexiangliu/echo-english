{
  "manifest_version": 3,
  "name": "Echo · 配音与唱歌练习",
  "version": "0.36.18",
  "description": "把喜欢的 YouTube 对白和歌曲变成自己的声音：多语言原文、逐句练习、伴奏录唱和录音对比。",
  "action": {
    "default_title": "打开 / 收起配音练习",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "subtitles.js",
        "transcript.js",
        "caption-tracks.js",
        "dictionary.js",
        "audio-analysis.js",
        "live-meter.js",
        "vocal-effects.js",
        "vendor/soundtouch.js",
        "backing-pitch.js",
        "microphone.js",
        "recording.js",
        "audio-export.js",
        "assembly.js",
        "karaoke.js",
        "original-audio.js",
        "models.js",
        "selection.js",
        "practice.js",
        "panel-size.js",
        "storage.js",
        "practice-package.js",
        "library.js",
        "languages.js",
        "panel-view.js",
        "transport.js",
        "playback.js",
        "playback-controls.js",
        "reference-playback.js",
        "practice-tools.js",
        "settings-dialog.js",
        "subtitle-editor.js",
        "subtitle-editor-view.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "caption-current.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "http://127.0.0.1:8765/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
